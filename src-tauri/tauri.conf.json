{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SYNX",
  "version": "1.0.0",
  "identifier": "com.synx.racing",
  "build": {
    "frontendDist": "../web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "copyright": "SYNX",
    "category": "Game",
    "shortDescription": "Synthwave eXtreme Racing",
    "longDescription": "A neon racer: seven chapters, one 173 km road, and an open route through all of it.",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
