# SYNX — the game.
#
# The multiplayer server is NOT part of this repository. It has its own, and is
# deployed from there on its own schedule. Cloning it in beside the game is
# convenient for working on both at once, so the checkout is ignored here.
#
# Nothing is shared by path any more. The game carries its own copy of the wire
# format at crates/synx-net and the server carries its, and the two are held
# together at runtime by the fingerprint in the handshake rather than at build
# time by a directory that has to exist. This repository builds on its own.
/synx-server/
/server/

# ---------------------------------------------------------------- build ----
/target/
**/*.rs.bk
*.pdb

# Tauri's generated host scaffolding. `gen/schemas` is regenerated by
# tauri-build on every compile.
/src-tauri/gen/schemas/

# The compiled simulation core. It is an artefact of
#   cargo build -p synx-core --release --target wasm32-unknown-unknown
# which build.ps1 runs and copies into place, so a stale one in the history is
# worse than none.
/web/wasm/*.wasm

# The differential harness writes here.
/target/diff/

# ----------------------------------------------------------------- tools ----
/tools/__pycache__/
__pycache__/
*.pyc
node_modules/

# Smoke-test leftovers: screenshots, traces and the temporary profile the
# headless browser is launched with.
/tools/*.png
/tools/*.trace
/tools/.profile/

# ---------------------------------------------------------------- editors ----
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------------- logs ----
*.log
npm-debug.log*

# ------------------------------------------------------------------ local ----
# Nothing in the game reads a .env, but a local override of the multiplayer
# server address goes in one, and it should not be committed.
.env
.env.*
!.env.example

# ---------------------------------------------------------------- assets ----
# web/data/synx.pak (58 MB) and web/data/scene.bin (11 MB) ARE tracked: the
# game does not run without them and they change rarely. They are past the size
# at which GitHub starts warning, so if this repository is pushed there, track
# them with Git LFS first:
#
#     git lfs track "web/data/*.pak" "web/data/*.bin"
#
# Do not add them here - a clone without them is a clone that cannot start.

# Derived: `python tools/assets.py unpack` writes it, `python tools/assets.py pack` reads it.
# The pack is the source of truth; this is the scratch copy you edit in.
assets-src/
